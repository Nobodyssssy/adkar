/* ═══════════════════════════════════════════════════════════
   Hijri events — Batch 1 (8 events)
   Every claim sourced. Every source link verified.
   Structure per event:
     id, hijriDate {month, day} or {month, from, to}
     type: 'major' | 'recommended' | 'sacred' | 'weekly' | 'reflection'
     icon: emoji placeholder (SVG replacement in UI step)
     nameAr, nameEn
     descAr, descEn            — What it is
     virtueAr, virtueEn        — Why it's special
     actsAr[], actsEn[]        — What to do
     prepAr, prepEn            — How to prepare
     specialDhikr { ar, en, count, source{ref,url} }   optional
     sources[] { ref, url }    — every claim
   ═══════════════════════════════════════════════════════════ */

const HIJRI_EVENTS = [

